<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Green Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#006A4E" />
        </shape>
    </item>

    <!-- Red Circle -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#F42A41" />
        </shape>
    </item>
</layer-list>
